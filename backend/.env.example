# Use a unique URL-safe hexadecimal password; do not use existing DEV credentials.
BACKEND_DB_PASSWORD=
BACKEND_API_DB_PASSWORD=
BACKEND_WORKER_DB_PASSWORD=
# Stable Fernet key shared by the native API and worker. Back it up securely.
SENDER_CREDENTIAL_ENCRYPTION_KEY=
BACKEND_MODEL_BASE_URL=https://api.xkiro.com/v1
BACKEND_MODEL_NAME=mistralai/mistral-large-2512
BACKEND_MODEL_AUTH_HEADER=Authorization
BACKEND_MODEL_API_KEY=
BACKEND_BRAVE_SEARCH_API_KEY=
# xKiro accepts either Authorization: Bearer <key> or x-api-key: <key>.
# xKiro accepts either Authorization: Bearer <key> or x-api-key: <key>.
# Platform operator configuration. Use confirmed provider rates, never guessed rates.
BACKEND_MODEL_INPUT_USD_PER_MILLION=
BACKEND_MODEL_OUTPUT_USD_PER_MILLION=
BACKEND_SEARCH_USD_PER_REQUEST=
# API-provider reservation allowance only; does not include hosting or other systems.
BACKEND_PROVIDER_MONTHLY_BUDGET_USD=50

# Optional guarded Chromium fallback for JavaScript-heavy company pages.
# Enabling it also installs Chromium in the compose.backend worker image.
BACKEND_DISCOVERY_BROWSER_FALLBACK=false

# Native dashboard is loopback-only; DEV hostname uses origin port 8081.
NATIVE_DASHBOARD_SECURE_COOKIES=true
