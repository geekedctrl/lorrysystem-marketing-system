APP_ENV=development

POSTGRES_HOST=postgres-dev
POSTGRES_PORT=5432
POSTGRES_DB=lorrysystem_dev
POSTGRES_USER=lorrysystem_dev
POSTGRES_PASSWORD=CHANGE_ME

MARKETING_API_KEY=CHANGE_ME

# Compatibility key is restricted to the original LorrySystem workspace.
# Disable after moving existing n8n workflows to workspace credentials.
ENABLE_LEGACY_API_KEY=true

# Allowed hosts for administrator-configured dashboard discovery webhooks.
# The DEV default is n8n-dev.obsidian.cam. Set this in the API container
# environment when connecting an n8n instance on a different host.
DISCOVERY_WEBHOOK_ALLOWED_HOSTS=n8n-dev.obsidian.cam
