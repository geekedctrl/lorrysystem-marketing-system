APP_ENV=development

POSTGRES_HOST=postgres-dev
POSTGRES_PORT=5432
POSTGRES_DB=lorrysystem_dev
POSTGRES_USER=lorrysystem_dev
POSTGRES_PASSWORD=CHANGE_ME

MARKETING_API_KEY=CHANGE_ME

# Compatibility key is restricted to the original LorrySystem workspace.
# Disable after moving existing n8n workflows to workspace credentials.
ENABLE_LEGACY_API_KEY=true

# Allowed hosts for administrator-configured dashboard discovery webhooks.
# The DEV default is n8n-dev.obsidian.cam. Set this in the API container
# environment when connecting an n8n instance on a different host.
DISCOVERY_WEBHOOK_ALLOWED_HOSTS=n8n-dev.obsidian.cam

# Optional platform rates for search/model estimates. Leave blank until verified.
# Set in the API container environment; unavailable pricing is displayed honestly.
AUTOMATION_SEARCH_USD_PER_REQUEST=
AUTOMATION_LLM_INPUT_USD_PER_MILLION=
AUTOMATION_LLM_OUTPUT_USD_PER_MILLION=

# One-time platform secret: a Fernet key for encrypted workspace SMTP passwords.
# Required only when connecting senders. Keep stable across deployments/backups.
# Generate privately using cryptography.fernet.Fernet.generate_key().
SMTP_CREDENTIAL_ENCRYPTION_KEY=

# Native Python worker stack for the staged DEV cutover. Generate three
# different URL-safe hex passwords (for example: openssl rand -hex 32).
BACKEND_DB_PASSWORD=
BACKEND_API_DB_PASSWORD=
BACKEND_WORKER_DB_PASSWORD=

# Shared provider credentials used only by the native worker. Do not reuse or
# commit plaintext values; keep the server's ignored .env file mode 600.
BACKEND_MODEL_BASE_URL=https://api.xkiro.com/v1
BACKEND_MODEL_NAME=mistralai/mistral-large-2512
BACKEND_MODEL_AUTH_HEADER=Authorization
BACKEND_MODEL_API_KEY=
BACKEND_BRAVE_SEARCH_API_KEY=

# Enter confirmed provider rates before enabling live discovery.
BACKEND_MODEL_INPUT_USD_PER_MILLION=
BACKEND_MODEL_OUTPUT_USD_PER_MILLION=
BACKEND_SEARCH_USD_PER_REQUEST=
BACKEND_PROVIDER_MONTHLY_BUDGET_USD=50
BACKEND_DISCOVERY_BROWSER_FALLBACK=false
NATIVE_DASHBOARD_SECURE_COOKIES=true
# Loopback ports; DEV routes the dashboard hostname to port 8081.
NATIVE_API_HOST_PORT=8020
