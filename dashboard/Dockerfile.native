FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --create-home --uid 10002 native-dashboard

COPY app ./app
RUN chown -R native-dashboard:native-dashboard /app

USER native-dashboard
EXPOSE 8080

CMD ["uvicorn", "app.native:app", "--host", "0.0.0.0", "--port", "8080"]
